{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "server:app", "--reload", "--port", "8001"],
      "cwd": "backend",
      "port": 8001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "cwd": "frontend",
      "port": 3000,
      "autoPort": true,
      "env": {
        "BROWSER": "none",
        "CI": "false"
      }
    }
  ]
}
